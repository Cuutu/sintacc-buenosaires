{
	"appId": "com.celimap.app",
	"appName": "Celimap",
	"webDir": "www",
	"server": {
		"url": "https://www.celimap.com.ar",
		"cleartext": false
	},
	"android": {
		"appendUserAgent": " CelimapNative/1",
		"backgroundColor": "#0b1220",
		"allowMixedContent": false
	},
	"ios": {
		"appendUserAgent": " CelimapNative/1",
		"backgroundColor": "#0b1220"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": true,
			"backgroundColor": "#0b1220",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0b1220",
			"overlaysWebView": true
		},
		"SocialLogin": {
			"providers": {
				"google": true,
				"apple": true,
				"facebook": false,
				"twitter": false
			}
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"SocialLoginPlugin"
	]
}

# MongoDB
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/sintacc-bsas?retryWrites=true&w=majority

# Site URL (canonical links, SEO, emails)
NEXT_PUBLIC_BASE_URL=https://www.celimap.com.ar

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secret-random-aqui-con-openssl-rand-base64-32

# Google OAuth (Web — NextAuth browser login + native serverAuthCode exchange)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Google OAuth iOS (Capacitor Social Login — Client ID only, no secret)
GOOGLE_IOS_CLIENT_ID=tu-ios-client-id.apps.googleusercontent.com
# Public copies for native SDK init (Etapa B). Same values as above web/iOS client IDs.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=tu-ios-client-id.apps.googleusercontent.com
# Feature flag: enable POST /api/auth/native/google. Default off in example; prod iOS needs on.
NATIVE_GOOGLE_AUTH_ENABLED=false

# Sign in with Apple (server). Bundle audience default: com.celimap.app (NOT a web Services ID).
# NATIVE_APPLE_AUTH_ENABLED defaults to enabled in code; set 0/false to disable.
NATIVE_APPLE_AUTH_ENABLED=true
APPLE_CLIENT_ID=com.celimap.app
APPLE_BUNDLE_ID=com.celimap.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Paste .p8 PEM as multiline or with \n escapes. NEVER commit a real key. NEVER use NEXT_PUBLIC_*.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_P8_CONTENTS\n-----END PRIVATE KEY-----"

# Account deletion: set 1 only on Atlas replica set after verifying transactions.
# ACCOUNT_DELETION_USE_TXN=0

# Google Maps Platform (Places API + Geocoding API) — solo servidor
GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# Google Maps JavaScript / Places UI Kit — solo navegador (HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=tu-google-maps-browser-key
# Prueba controlada de fotos Google en FeaturedCard (true|false)
NEXT_PUBLIC_GOOGLE_PLACE_PHOTOS_ENABLED=false

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Admin emails (separados por coma)
ADMIN_EMAILS=admin@ejemplo.com,otro@ejemplo.com

# Contacto: email donde llegan las consultas del formulario (opcional, usa primer ADMIN_EMAIL si no se define)
CONTACT_EMAIL=tu-email@ejemplo.com

# Resend: para enviar emails de contacto (https://resend.com)
RESEND_API_KEY=re_xxxxx
# Si verificaste un dominio en Resend, usa: noreply@tudominio.com
RESEND_FROM_DOMAIN=onboarding@resend.dev

# Feature flags (opcional, default: phase1)
FEATURES=phase1

# Listas privadas (MVP colaboradores). Default off.
# PRIVATE_LISTS_ENABLED=true habilita el feature.
# PRIVATE_LISTS_ALLOWLIST=emails separados por coma (admins siempre permitidos si flag on).
PRIVATE_LISTS_ENABLED=false
PRIVATE_LISTS_ALLOWLIST=

# OpenRouter — solo servidor, admin redes sociales (CTA/hitos con IA)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_IMAGE_MODEL=openai/gpt-5-image-mini

# OpenRouter — investigación GF en sugerencias (semi-auto, admin aprueba)
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
PLACE_RESEARCH_ENABLED=true
PLACE_RESEARCH_AUTO_ON_SUBMIT=true

# Cola de enriquecimiento IA en lugares (worker encadenado en Vercel)
INTERNAL_JOB_SECRET=genera-un-secret-largo-aleatorio

{
	"appId": "com.celimap.app",
	"appName": "Celimap",
	"webDir": "www",
	"server": {
		"url": "https://www.celimap.com.ar",
		"cleartext": false,
		"errorPath": "index.html"
	},
	"android": {
		"appendUserAgent": " CelimapNative/1",
		"backgroundColor": "#F7F3EB",
		"allowMixedContent": false
	},
	"ios": {
		"appendUserAgent": " CelimapNative/1",
		"backgroundColor": "#F7F3EB"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": true,
			"backgroundColor": "#F7F3EB",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#F7F3EB",
			"overlaysWebView": true
		},
		"SocialLogin": {
			"providers": {
				"google": true,
				"apple": true,
				"facebook": false,
				"twitter": false
			}
		}
	}
}

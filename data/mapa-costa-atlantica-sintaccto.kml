      <name>Mar del Plata</name>
      <Placemark>
        <name>El Domo Cafe</name>
        <description><![CDATA[-Tipo de comercio: Restaurante / Cafetería<br><br>-Modalidad: Salón / Take away / Delivery propio<br><br>-Tipo de producto: Elaboración propia<br><br>-Materia prima: Certificada sin gluten<br><br>-Cocina: Cocina mixta con cuidados en contaminación cruzada<br><br>-Horarios de atención:<br>Lunes - 7 a 1 horas<br>Martes - 7 a 1 horas<br>Miércoles - 7 a 1 horas<br>Jueves - 7 a 1 horas<br>Viernes - 7 a 1 horas<br>Sábado - 7 a 1 horas<br>Domingo - 7 a 1 horas<br><br>Instagram: @eldomocafe]]></description>
        <styleUrl>#icon-1577-FFEA00</styleUrl>
        <Point>
          <coordinates>
            -57.553202,-38.0087998,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Java gluten free</name>
        <description><![CDATA[-Tipo de comercio: Pizzeria<br><br>-Modalidad: Take away / Delivery propio<br><br>-Tipo de producto: Elaboración propia<br><br>-Materia prima: Certificada sin gluten<br><br>-Cocina: Cocina 100% libre de gluten<br><br>-Horarios de atención:<br>Lunes - 12 a 14 y 20 a 23 horas<br>Martes - 12 a 14 y 20 a 23 horas<br>Miércoles - 12 a 14 y 20 a 23 horas<br>Jueves - 12 a 14 y 20 a 23 horas<br>Viernes - 12 a 14 y 20 a 23 horas<br>Sábado - 12 a 14 y 20 a 23 horas<br>Domingo - 20 a 23 horas<br><br>Instagram: @java.glutenfree]]></description>

diff --git a/capacitor.config.ts b/capacitor.config.ts
index 1a1b36a..51e02ce 100644
--- a/capacitor.config.ts
+++ b/capacitor.config.ts
@@ -1,12 +1,61 @@
 import type { CapacitorConfig } from "@capacitor/cli"
 
+/**
+ * server.url se resuelve en sync-time (m├íquina del developer / CI), no en runtime WebView.
+ *
+ * Producci├│n (default):
+ *   npx cap sync
+ *   ÔåÆ siempre https://www.celimap.com.ar
+ *
+ * Preview / staging (expl├¡cito, nunca accidental):
+ *   CAPACITOR_SERVER_MODE=preview CAPACITOR_SERVER_URL=https://<host> npx cap sync
+ *
+ * Guardas:
+ * - URL sola sin MODE=preview ÔåÆ throw (bloquea override accidental)
+ * - MODE=preview sin URL ÔåÆ throw
+ * - Release CI: no definir CAPACITOR_SERVER_* ÔåÆ prod garantizado
+ */
+
+const PROD_SERVER_URL = "https://www.celimap.com.ar"
+
+function resolveServer(): { url: string; cleartext: boolean } {
+  const mode = process.env.CAPACITOR_SERVER_MODE?.trim()
+  const previewUrl = process.env.CAPACITOR_SERVER_URL?.trim()
+
+  if (previewUrl && mode !== "preview") {
+    throw new Error(
+      "[capacitor] CAPACITOR_SERVER_URL definido sin CAPACITOR_SERVER_MODE=preview. " +
+        "Abortando para no apuntar Release a staging por error."
+    )
+  }
+
+  if (mode === "preview") {
+    if (!previewUrl) {
+      throw new Error(
+        "[capacitor] CAPACITOR_SERVER_MODE=preview requiere CAPACITOR_SERVER_URL."
+      )
+    }
+    if (previewUrl === PROD_SERVER_URL) {
+      throw new Error(
+        "[capacitor] preview no puede usar URL de producci├│n. Quit├í MODE=preview."
+      )
+    }
+    const cleartext = previewUrl.startsWith("http://")
+    return { url: previewUrl, cleartext }
+  }
+
+  return { url: PROD_SERVER_URL, cleartext: false }
+}
+
+const server = resolveServer()
+
 const config: CapacitorConfig = {
   appId: "com.celimap.app",
   appName: "Celimap",
   webDir: "www",
   server: {
-    url: "https://www.celimap.com.ar",
-    cleartext: false,
+    url: server.url,
+    cleartext: server.cleartext,
   },
   android: {
     appendUserAgent: " CelimapNative/1",
@@ -28,6 +77,8 @@ const config: CapacitorConfig = {
     StatusBar: {
       style: "DARK",
       backgroundColor: "#0b1220",
+      // Pol├¡tica B: WebView edge-to-edge; insets v├¡a CSS env(safe-area-*)
+      overlaysWebView: true,
     },
   },
 }
